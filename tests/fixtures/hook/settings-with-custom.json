{
  "permissions": {
    "allow": [
      "Bash(git status:*)"
    ]
  },
  "env": {
    "EXAMPLE": "preserved"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo user-hook"
          }
        ]
      }
    ]
  }
}
